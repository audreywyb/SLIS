                    description: "The district introduces a new learning management system (LMS), and staff members are stressed, confused, and struggling to move their lesson files online.",
                    citationUrl: "https://journals.sagepub.com/doi/abs/10.1177/0031721718767854",
                    citationText: "Lance, K. C., & Kachel, D. E. (2018). Why school librarians matter: What years of research tells us. Phi Delta Kappan, 99(7), 15-20.",
                    choices: [
                        { text: "Host short 'Coffee & Tech' drop-in support clinics in the library morning space, sharing templates that connect library tools directly to the new LMS.", feedback: "Incredible leadership. Stepping up as a tech mentor stamps your status as an invaluable school hub.", isOptimal: true },
                        { text: "Lock the office door and focus on cataloging books until the digital rollout confusion settles down.", feedback: "Hiding during school transitions detaches the library program from essential instructional leadership opportunities.", isOptimal: false },
                        { text: "Send out a massive list of support links from the LMS vendor's default engineering user guide website.", feedback: "Staff members are already overwhelmed. They need human-centered scaffolding, not more links.", isOptimal: false },
                        { text: "Tell teachers that you cannot help with the new software since the tech support office handles server accounts.", feedback: "While you don't manage accounts, you can facilitate pedagogical integration.", isOptimal: false }
                    ]
                }
            ]
        };

        /**
         * STREAMING_CHUNK:Building the simulation flow engine...
         */
        const SimulationEngine = {
            domainSequence: ["D1", "D2", "D3", "D4", "D5"],
            sequenceIndex: 0,
            isCurrentScenarioRemedial: false,
            masteredDomains: new Set(),

            nodes: {
                welcome: null,
                scenario: null,
                results: null,
                stepIndicator: null,
                remediationBadge: null,
                title: null,
                description: null,
                citation: null,
                choicesBox: null,
                unlockedSpan: null,
                statusText: null
            },

            /**
             * Safely registers references to DOM elements
             */
            init() {
                this.nodes.welcome = document.getElementById("welcome-card");
                this.nodes.scenario = document.getElementById("scenario-card");
                this.nodes.results = document.getElementById("results-card");
                this.nodes.stepIndicator = document.getElementById("scenario-step-indicator");
                this.nodes.remediationBadge = document.getElementById("remediation-badge");
                this.nodes.title = document.getElementById("scenario-title");
                this.nodes.description = document.getElementById("scenario-description");
                this.nodes.citation = document.getElementById("scenario-citation");
                this.nodes.choicesBox = document.getElementById("choices-container");
                this.nodes.unlockedSpan = document.getElementById("unlocked-count");
                this.nodes.statusText = document.getElementById("simulation-status-text");
                
                this.resetTrackedVisualElements();
            },

            /**
             * Resets the active elements and resets SVG tracker nodes
             */
            resetTrackedVisualElements() {
                this.masteredDomains.clear();
                this.sequenceIndex = 0;
                this.isCurrentScenarioRemedial = false;
                
                if (this.nodes.unlockedSpan) this.nodes.unlockedSpan.textContent = "0";
                if (this.nodes.statusText) {
                    this.nodes.statusText.textContent = "READY TO BEGIN";
                    this.nodes.statusText.className = "text-amber-400 animate-pulse font-mono text-xs";
                }

                this.domainSequence.forEach(id => {
                    const node = document.getElementById(`node-${id}`);
                    const fill = document.getElementById(`fill-${id}`);
                    const text = document.getElementById(`text-${id}-title`);
                    const check = document.getElementById(`check-${id}`);

                    if (node) node.setAttribute("opacity", "0.3");
                    if (fill) fill.setAttribute("width", "0");
                    if (text) text.setAttribute("fill", "#94a3b8");
                    if (check) check.setAttribute("fill", "#475569");
                });
            },

            /**
             * Manages view panel swaps cleanly by modifying display CSS classes
             */
            updateLayoutVisibility(targetCard) {
                if (!this.nodes.welcome) return; // Guard clause against uninitialized setups
                
                this.nodes.welcome.classList.add("hidden");
                this.nodes.scenario.classList.add("hidden");
                this.nodes.results.classList.add("hidden");

                if (targetCard === "welcome") this.nodes.welcome.classList.remove("hidden");
                if (targetCard === "scenario") this.nodes.scenario.classList.remove("hidden");
                if (targetCard === "results") this.nodes.results.classList.remove("hidden");
            },

            /**
             * Starts or restarts the simulation cycle
             */
            start() {
                this.resetTrackedVisualElements();
                this.updateLayoutVisibility("scenario");
                this.renderActiveScenario();
            },

            /**
             * Renders the current state's active scenario (Primary or Remedial)
             */
            renderActiveScenario() {
                if (this.sequenceIndex >= this.domainSequence.length) {
                    this.completeSimulationPipeline();
                    return;
                }

                const currentDomainId = this.domainSequence[this.sequenceIndex];
                const activePool = SCENARIOS_POOL[currentDomainId];
                
                // Select either primary object scenario or pull from the fallback remediation array index
                const data = this.isCurrentScenarioRemedial ? activePool[1] : activePool[0];

                this.nodes.stepIndicator.textContent = `Focus Area: Domain ${this.sequenceIndex + 1} of 5`;
                
                if (this.isCurrentScenarioRemedial) {
                    this.nodes.remediationBadge.classList.remove("hidden");
                } else {
                    this.nodes.remediationBadge.classList.add("hidden");
                }

                this.nodes.title.textContent = data.title;
                this.nodes.description.textContent = data.description;
                this.nodes.citation.innerHTML = `<strong>${data.standardRef}</strong> — Research Base: <a href="${data.citationUrl}" target="_blank" class="text-blue-600 hover:text-blue-800 underline font-medium inline-flex items-center gap-0.5">${data.citationText} <span class="text-[10px]">↗</span></a>`;

                this.nodes.choicesBox.innerHTML = "";

                data.choices.forEach((choice) => {
                    const button = document.createElement("button");
                    button.type = "button";
                    button.className = "w-full text-left p-4 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 hover:border-blue-400 active:bg-blue-50 transition-all text-sm font-medium text-slate-700 cursor-pointer shadow-sm flex gap-3 items-start group";
                    button.innerHTML = `
                        <div class="mt-0.5 min-w-[18px] h-[18px] rounded-full border border-slate-300 group-hover:border-blue-500 bg-white flex items-center justify-center transition-all">
                            <div class="w-2 h-2 rounded-full bg-blue-600 opacity-0 group-hover:opacity-40 transition-all"></div>
                        </div>
                        <span class="flex-1 leading-relaxed font-normal">${choice.text}</span>
                    `;
                    button.onclick = () => this.handleUserSelectionChoice(choice, data);
                    this.nodes.choicesBox.appendChild(button);
                });

                this.nodes.statusText.textContent = `EXPLORING DOMAIN ${currentDomainId}`;
                this.nodes.statusText.className = "text-blue-400 font-mono text-xs tracking-wider";
            },

            /**
             * Evaluates correctness, updates UI tracking dashboard, or triggers remedial pathing
             */
            handleUserSelectionChoice(choice, scenarioData) {
                if (choice.isOptimal) {
                    alert(`🟢 Excellent Approach!\n\n${choice.feedback}`);
                    
                    // Award points and animate the progress bar tracker
                    this.activateDomainTrackerBoardNode(scenarioData.domain, scenarioData.color);
                    
                    // Move to the next standard domain and clear the remedial modifier flag
                    this.sequenceIndex++;
                    this.isCurrentScenarioRemedial = false;
                } else {
                    alert(`💡 Alternative Pathway Thought\n\n${choice.feedback}\n\nLet's pivot and try a fresh scenario for this domain framework to build up confidence!`);
                    
                    // Set remedial modifier flag to true - causing the engine to pull the backup case file
                    this.isCurrentScenarioRemedial = true;
                }
                
                this.renderActiveScenario();
            },

            /**
             * Drives updates of tracker nodes on the SVG map interface
             */
            activateDomainTrackerBoardNode(domainId, hexColor) {
                this.masteredDomains.add(domainId);
                this.nodes.unlockedSpan.textContent = this.masteredDomains.size;

                const node = document.getElementById(`node-${domainId}`);
                const fill = document.getElementById(`fill-${domainId}`);
                const text = document.getElementById(`text-${domainId}-title`);
                const check = document.getElementById(`check-${domainId}`);

                if (node) node.setAttribute("opacity", "1.0");
                if (fill) fill.setAttribute("width", "370"); 
                if (text) text.setAttribute("fill", "#ffffff");
                if (check) check.setAttribute("fill", "#10b981"); 
            },

            /**
             * Completes the simulation pipeline loop cleanly
             */
            completeSimulationPipeline() {
                this.updateLayoutVisibility("results");
                this.nodes.statusText.textContent = "ALL DOMAINS MASTERED";
                this.nodes.statusText.className = "text-emerald-400 font-mono font-bold text-xs";
            },

            /**
             * Re-initializes state variables back to baseline values
             */
            reset() {
                this.updateLayoutVisibility("welcome");
                this.resetTrackedVisualElements();
            }
        };

        // Bind to global window context so inline element handlers can securely target the namespace
        window.SimulationEngine = SimulationEngine;

        // Perform loading check to bypass timing differences in interactive sandboxes
        if (document.readyState === "complete" || document.readyState === "interactive") {
            SimulationEngine.init();
        } else {
            document.addEventListener("DOMContentLoaded", () => {
                SimulationEngine.init();
            });
        }
    </script>
</body>
</html>
